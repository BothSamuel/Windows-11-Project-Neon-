// ============================================================================

void RestoreTrackedButton(const TrackedButton& tracked) {
    auto panel = tracked.panel.get();
    if (!panel) return;

    auto weakPanel = tracked.panel;
    auto weakNativeIcon = tracked.nativeIcon;
    auto originalVisibility = tracked.originalNativeIconVisibility;
    auto elementName = tracked.customElementName;

    auto cleanup = [weakPanel, weakNativeIcon, originalVisibility, elementName]() {
        auto currentPanel = weakPanel.get();
        if (!currentPanel) return;
        try {
            auto children = currentPanel.Children();
            for (int i = static_cast<int>(children.Size()) - 1; i >= 0; i--) {
                auto child = children.GetAt(i).try_as<wux::FrameworkElement>();
                if (child && child.Name() == elementName) {
                    children.RemoveAt(i);
                }
            }
            if (auto nativeIcon = weakNativeIcon.get()) {
                nativeIcon.Visibility(originalVisibility);
            }
        } catch (...) {}
    };

    try {
        auto dispatcher = panel.Dispatcher();
        if (dispatcher.HasThreadAccess()) {
            cleanup();
        } else {
            dispatcher.RunAsync(winrt::Windows::UI::Core::CoreDispatcherPriority::Normal, cleanup).get();
        }
    } catch (...) {}
}

void CleanupAllButtons() {
    std::vector<TrackedButton> trackedButtons;
    {
        std::lock_guard<std::mutex> lock(g_trackedButtonsMutex);
        trackedButtons = std::move(g_trackedButtons);
    }
    for (const auto& tracked : trackedButtons) {
        RestoreTrackedButton(tracked);
    }
}

void LoadSettings() {
    PCWSTR themeSetting = Wh_GetStringSetting(L"theme_mode");
    g_settings.themeMode = themeSetting ? themeSetting : L"auto";
    Wh_FreeStringSetting(themeSetting);

    g_settings.enableStartLogo = Wh_GetIntSetting(L"enable_start_logo");
    g_settings.startLogoSize = static_cast<double>(Wh_GetIntSetting(L"start_logo_size"));
    g_settings.enableTaskView = Wh_GetIntSetting(L"enable_task_view");
    g_settings.taskViewSize = static_cast<double>(Wh_GetIntSetting(L"task_view_size"));
}

