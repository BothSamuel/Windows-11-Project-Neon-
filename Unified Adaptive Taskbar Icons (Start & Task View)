void TrackButton(const wuxc::Panel& panel, const wux::FrameworkElement& nativeIcon, wux::Visibility originalVisibility, std::wstring customName) {
    void* panelAbi = winrt::get_abi(panel);
    std::lock_guard<std::mutex> lock(g_trackedButtonsMutex);

    for (auto it = g_trackedButtons.begin(); it != g_trackedButtons.end();) {
        auto existingPanel = it->panel.get();
        if (!existingPanel) {
            it = g_trackedButtons.erase(it);
            continue;
        }
        if (winrt::get_abi(existingPanel) == panelAbi && it->customElementName == customName) {
            return;
        }
        ++it;
    }

    g_trackedButtons.push_back({winrt::make_weak(panel), winrt::make_weak(nativeIcon), originalVisibility, customName});
}

void ApplyToTaskbarButton(const wux::FrameworkElement& button) {
    if (!button || g_unloading) return;

    auto autoId = wuxa::AutomationProperties::GetAutomationId(button);
    bool isStart = (autoId == kStartButtonAutomationId);
    bool isTaskView = (autoId == kTaskViewButtonAutomationId);

    if (!isStart && !isTaskView) return;

    auto panel = FindDescendantByName(button, kRootPanelName).try_as<wuxc::Grid>();
    if (!panel) return;

    auto nativeIcon = FindDescendantByName(panel, kNativeIconName);
    if (!nativeIcon) return;

    bool isDarkMode = ShouldUseDarkMode();

    if (isStart) {
        if (!g_settings.enableStartLogo) return;

        auto logo = FindDescendantByName(panel, kStartLogoName).try_as<wuxc::Grid>();
        if (!logo) {
            auto originalVisibility = nativeIcon.Visibility();
            logo = CreateWindows11Logo(g_settings.startLogoSize, isDarkMode);
            TrackButton(panel, nativeIcon, originalVisibility, kStartLogoName);
            nativeIcon.Visibility(wux::Visibility::Collapsed);
            panel.Children().Append(logo);
        } else {
            nativeIcon.Visibility(wux::Visibility::Collapsed);
        }
        ApplyStartLogoState(logo, ReadNativeButtonState(panel, button), isDarkMode);
    } else if (isTaskView) {
        if (!g_settings.enableTaskView) return;

        auto icon = FindDescendantByName(panel, kTaskViewIconName).try_as<wuxc::Grid>();
        if (!icon) {
            auto originalVisibility = nativeIcon.Visibility();
            icon = CreateTaskViewIcon(g_settings.taskViewSize, isDarkMode);
            TrackButton(panel, nativeIcon, originalVisibility, kTaskViewIconName);
            nativeIcon.Visibility(wux::Visibility::Collapsed);
            panel.Children().Append(icon);
        } else {
            nativeIcon.Visibility(wux::Visibility::Collapsed);
        }
        ApplyTaskViewIconState(icon, ReadNativeButtonState(panel, button), isDarkMode);
    }
}

