NativeButtonState ReadNativeButtonState(const wux::FrameworkElement& panel, const wux::FrameworkElement& button) {
    NativeButtonState result;
    try {
        auto groups = wux::VisualStateManager::GetVisualStateGroups(panel);
        for (const auto& group : groups) {
            if (group.Name() != L"CommonStates") continue;
            auto currentState = group.CurrentState();
            if (!currentState) break;

            auto stateNameString = currentState.Name();
            std::wstring_view stateName{stateNameString.c_str(), stateNameString.size()};
            result.active = stateName.starts_with(L"Active");
            result.pointerOver = stateName.ends_with(L"PointerOver");
            result.pressed = stateName.ends_with(L"Pressed");
            return result;
        }
    } catch (...) {}

    try {
        if (auto buttonBase = button.try_as<wuxcp::ButtonBase>()) {
            result.pressed = buttonBase.IsPressed();
        }
        if (auto toggleButton = button.try_as<wuxcp::ToggleButton>()) {
            if (auto checked = toggleButton.IsChecked()) {
                result.active = checked.Value();
            }
        }
    } catch (...) {}

    return result;
}

void ApplyStartLogoState(const wuxc::Grid& logo, const NativeButtonState& state, bool isDarkMode) {
    int32_t previousState = -1;
    if (auto tag = logo.Tag()) {
        previousState = winrt::unbox_value_or<int32_t>(tag, -1);
    }

    bool menuOpen = previousState >= 0 && (previousState & 8) != 0;
    if (!state.pressed) menuOpen = state.active;

    int32_t newState = (menuOpen ? 8 : 0) | (state.active ? 4 : 0) | (state.pointerOver ? 2 : 0) | (state.pressed ? 1 : 0);
    if (previousState == newState) return;

    logo.Tag(winrt::box_value(newState));
    bool initialized = previousState >= 0;
    bool wasPressed = initialized && (previousState & 1) != 0;
    bool menuJustOpened = initialized && (previousState & 8) == 0 && menuOpen && !state.pressed;

    if (!initialized) {
        float initialScale = state.pressed ? kStartPressedScale : 1.00f;
        AnimateElementScale(logo, static_cast<float>(g_settings.startLogoSize), initialScale, initialScale, false, 0);
    } else if (wasPressed != state.pressed) {
        if (state.pressed) {
            AnimateElementScale(logo, static_cast<float>(g_settings.startLogoSize), 1.00f, kStartPressedScale, true, kPressDurationMs, {0.33f, 0.00f}, {0.67f, 1.00f});
        } else {
            AnimateElementScale(logo, static_cast<float>(g_settings.startLogoSize), kStartPressedScale, 1.00f, true, kReleaseDurationMs, {0.10f, 0.90f}, {0.20f, 1.00f});
        }
    }

    if (menuJustOpened) AnimateQuantumPaneWave(logo);

    winrt::Windows::UI::Color baseColor = isDarkMode ? kStartWhite : kStartBlack;
    winrt::Windows::UI::Color pressedColor = isDarkMode ? kStartGrayLight : kStartGrayDark;

    auto diagonalColor = baseColor;
    auto otherColor = baseColor;
    if (state.pressed) {
        if (!menuOpen) diagonalColor = otherColor = pressedColor;
    } else if (menuOpen) {
        diagonalColor = pressedColor;
    }

    bool animateColors = initialized && !state.pressed;
    auto pane1 = FindDescendantByName(logo, kPane1Name).try_as<wuxs::Rectangle>();
    auto pane2 = FindDescendantByName(logo, kPane2Name).try_as<wuxs::Rectangle>();
    auto pane3 = FindDescendantByName(logo, kPane3Name).try_as<wuxs::Rectangle>();
    auto pane4 = FindDescendantByName(logo, kPane4Name).try_as<wuxs::Rectangle>();

    if (pane1) AnimateBrushColor(pane1.Fill().try_as<wuxm::SolidColorBrush>(), diagonalColor, animateColors, kColorDurationMs);
    if (pane2) AnimateBrushColor(pane2.Fill().try_as<wuxm::SolidColorBrush>(), otherColor, animateColors, kColorDurationMs);
    if (pane3) AnimateBrushColor(pane3.Fill().try_as<wuxm::SolidColorBrush>(), otherColor, animateColors, kColorDurationMs);
    if (pane4) AnimateBrushColor(pane4.Fill().try_as<wuxm::SolidColorBrush>(), diagonalColor, animateColors, kColorDurationMs);
}

void ApplyTaskViewIconState(const wuxc::Grid& icon, const NativeButtonState& state, bool isDarkMode) {
    int32_t previousState = -1;
    if (auto tag = icon.Tag()) {
        previousState = winrt::unbox_value_or<int32_t>(tag, -1);
    }

    int32_t newState = (state.active ? 4 : 0) | (state.pointerOver ? 2 : 0) | (state.pressed ? 1 : 0);
    if (previousState == newState) return;

    icon.Tag(winrt::box_value(newState));
    bool initialized = previousState >= 0;
    bool wasPressed = initialized && (previousState & 1) != 0;

    if (!initialized) {
        float initialScale = state.pressed ? kTaskViewPressedScale : 1.00f;
        AnimateElementScale(icon, static_cast<float>(g_settings.taskViewSize), initialScale, initialScale, false, 0);
    } else if (wasPressed != state.pressed) {
        if (state.pressed) {
            AnimateElementScale(icon, static_cast<float>(g_settings.taskViewSize), 1.00f, kTaskViewPressedScale, true, kPressDurationMs);
        } else {
            AnimateElementScale(icon, static_cast<float>(g_settings.taskViewSize), kTaskViewPressedScale, 1.00f, true, kReleaseDurationMs);
        }
    }

    winrt::Windows::UI::Color targetColor = isDarkMode ? kStartWhite : kStartBlack;
    if (state.pressed) {
        targetColor = isDarkMode ? winrt::Windows::UI::Color{0xFF, 0xBF, 0xBF, 0xBF} : winrt::Windows::UI::Color{0xFF, 0x40, 0x40, 0x40};
    } else if (state.pointerOver || state.active) {
        targetColor = isDarkMode ? winrt::Windows::UI::Color{0xFF, 0xE0, 0xE0, 0xE0} : winrt::Windows::UI::Color{0xFF, 0x2B, 0x2B, 0x2B};
    }

    auto backCard = FindDescendantByName(icon, kBackCardName).try_as<wuxs::Rectangle>();
    auto frontCard = FindDescendantByName(icon, kFrontCardName).try_as<wuxs::Rectangle>();

    if (backCard && frontCard) {
        backCard.Stroke(wuxm::SolidColorBrush(targetColor));
        frontCard.Fill(wuxm::SolidColorBrush(targetColor));
    }
}

